APP_ENV=development
CHATBOT_API_KEY=change-this-chatbot-key
CLOUD_AUDIT_API_KEY=change-this-read-only-audit-key
MONITORING_API_KEY=change-this-monitoring-key
OPENAI_API_KEY=replace-with-an-openai-project-api-key
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=aci_chatbot
ACI_COLLECTION=aci_openai_chunks
ACI_VECTOR_INDEX=openai_vector_index
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
TOP_K=5
MAX_CONTEXT_CHARS=12000
ALLOW_ORIGINS=http://localhost:8000
LOG_LEVEL=INFO
RAG_DOMAIN=rag.example.com
GRAFANA_ADMIN_PASSWORD=replace-this-grafana-password

# --- request limits and cost control -----------------------------------------
# Enforced in-process, so the ceilings apply per instance, not per cluster.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_BURST=10
DAILY_TOKEN_BUDGET=200000
REQUEST_TIMEOUT_SECONDS=45

# --- declared service levels, judged by the assessor -------------------------
SLO_P95_LATENCY_MS=3000
SLO_ERROR_RATE=0.02

# --- retention ---------------------------------------------------------------
TRACE_RETENTION_SECONDS=3600
# Leave unset to declare that no disposal schedule exists; the audit adapter
# reports record_disposal_enforced=false, which an assessment will flag.
# RECORD_RETENTION_DAYS=90
